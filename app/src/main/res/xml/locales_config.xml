<?xml version="1.0" encoding="utf-8"?>
<!--
    FR-18 — declares the per-app supported UI locales so Android 13+ surfaces
    a "Language" entry for Tishina inside the system Settings > Apps panel.
    The same list mirrors `app/build.gradle.kts:resourceConfigurations` and
    the `AppLocale` enum in `:core:domain`.
-->
