<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!--
        allowBackup is intentionally disabled until Phase 3 lands the measurement
        DB (History + Persistence) and we author explicit data extraction / cloud
        backup rules. Default Auto Backup would otherwise replicate every recorded
        measurement (with any implicit user context) to Google with no review.
        Re-enable together with `android:dataExtractionRules` once a policy is in place.
    -->
    <application
        android:name=".TishinaApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tishina.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Tishina.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            FR-18 — On Android 12 and below `AppCompatDelegate.setApplicationLocales` only
            persists the per-app locale across cold starts when this service is declared
            with `autoStoreLocales=true` (AppCompat 1.6+ opt-in). Without it the locale
            disappears after process death because AppCompat has nothing to write to.
            On API 33+ the platform `LocaleManager` persists the value directly, and this
            service is unused — the declaration is harmless on newer APIs.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
            Phase 6 Task 9 — Macrobenchmark requires the target app to declare itself
            profileable so the macrobench instrumentation can attach the simpleperf /
            ART profiler on Android 10+ (API 29). Without this, the cold-start
            measurement runs but produces NOT-PROFILEABLE warnings and the timing
            samples are unreliable. `shell="true"` restricts attach access to the
            shell user (no production data exposure on user-builds); `enabled=true`
            keeps the declaration active across all build types. This declaration is
            inert on devices below API 29 and on builds whose target SDK ignores it.
        -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <!--
            Phase 6 Task 4 — FileProvider for the Detail share Intent (FR-10 P1).
            DetailViewModel renders a PNG snapshot of the chart into the app's private
            cache directory, then hands a `content://` URI to the share chooser via
            `FileProvider.getUriForFile`. `exported=false` + per-Intent
            `FLAG_GRANT_READ_URI_PERMISSION` keeps the grant scoped to the receiving
            app only — no broadcast-style access to the cache.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>

</manifest>
