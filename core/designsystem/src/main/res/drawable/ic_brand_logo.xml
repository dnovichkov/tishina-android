<?xml version="1.0" encoding="utf-8"?>
<!--
    In-app brand mark used by AboutScreen (and any future "brand display" surface).

    Same metaphor as the launcher foreground (damped sine wave → flat line, «звук →
    тишина»), but the geometry fills the full 108 viewport instead of the adaptive-icon
    safe zone — when this drawable is rendered inside a tinted Surface card the launcher
    mask doesn't apply, so the extra space is "real" pixels we can use.

    The stroke is opaque white so the `Icon(painter = ..., tint = colorScheme.X)` call
    site can recolour the silhouette per theme via Compose's source-tint blending — XML
    `?attr/...` theme attributes are not available in a Compose-only app (there is no
    AppCompat XML theme declaring them), so the wiring has to happen on the Composable
    side and not in this drawable.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M14,54 C20,12 26,12 32,54 C38,86 44,86 50,54 C55,40 60,40 65,54 L94,54" />

</vector>
